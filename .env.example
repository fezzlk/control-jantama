# control_jantama.config.Settings が読み込む環境変数。
# cp .env.example .env してから値を必要に応じて調整する。

# Playwrightの永続コンテキスト（ログインセッション）保存先
CONTROL_JANTAMA_USER_DATA_DIR=data/user_data_dir

# テンプレート画像の格納先
CONTROL_JANTAMA_TEMPLATES_DIR=assets/templates

# 取得したURLを保存するSQLite DBのパス
CONTROL_JANTAMA_DB_PATH=data/replay_urls.sqlite3

# テンプレート画像ファイル名（assets/templates/ 配下、scripts/capture_reference_screenshot.py の手順で用意する）
CONTROL_JANTAMA_SHARE_ICON_TEMPLATE=share_icon.png
CONTROL_JANTAMA_DIALOG_MARKER_TEMPLATE=dialog_marker.png
# コピー操作が別ボタンで必要な場合のみ設定（不要ならコメントアウトのまま）
# CONTROL_JANTAMA_COPY_BUTTON_TEMPLATE=copy_button.png

# テンプレートマッチングの一致閾値（0.0〜1.0）
CONTROL_JANTAMA_MATCH_THRESHOLD=0.85

# 共有URLとして許可するホスト名の一部（カンマ区切り、いずれかを含めば有効とみなす）
# 実機確認済み(2026-09-15): 共有URLは https://game.mahjongsoul.com/?paipu=... 形式
CONTROL_JANTAMA_URL_HOST_ALLOWLIST=mahjongsoul.com,maj-soul.com,yo-star.com

# 共有ダイアログ出現を待つ最大秒数
CONTROL_JANTAMA_DIALOG_APPEAR_TIMEOUT_SECONDS=10

# 固定ブラウザウィンドウサイズ
CONTROL_JANTAMA_VIEWPORT_WIDTH=1280
CONTROL_JANTAMA_VIEWPORT_HEIGHT=800

# 起動時に自動で開くURL（任意、ログイン自体は手動）
CONTROL_JANTAMA_START_URL=https://game.mahjongsoul.com/index.html

# 1回のスクロールで送る合計ホイール量(px)
# 実機確認(2026-09-15): 雀魂は1回の大きなwheelイベントをそのまま反映せず、
# ごく僅かしかスクロールしない。そのためSCROLL_TICK_PXずつの小刻みな
# イベントに分けて合計SCROLL_STEP_PXになるまで送る。実際の画面の動きを見て、
# 足りなければこの値を増やす。
CONTROL_JANTAMA_SCROLL_STEP_PX=2000
# 1回のwheelイベントで送る量(px)。実際のマウスホイール1ノッチに近い値。
CONTROL_JANTAMA_SCROLL_TICK_PX=120
# wheelイベント間の待機時間(ms)
CONTROL_JANTAMA_SCROLL_TICK_INTERVAL_MS=30

# スクロール回数の上限（未設定なら新規行が0件になるまで自動で続ける。
# 短時間大量アクセスを避けたい場合の安全弁として設定する）
# CONTROL_JANTAMA_MAX_SCROLL_STEPS=50

# スクロール後、雀魂側の遅延ロード完了を待つためのポーリング設定
CONTROL_JANTAMA_SCROLL_SETTLE_POLL_INTERVAL_MS=300
CONTROL_JANTAMA_SCROLL_SETTLE_STABLE_CHECKS=2
CONTROL_JANTAMA_SCROLL_SETTLE_TIMEOUT_SECONDS=5

# 2枚のスクリーンショットを「変化なし」とみなす類似度閾値(0.0〜1.0)
# 遅延ロード完了判定・一覧末尾到達判定の両方に使う
CONTROL_JANTAMA_SCREEN_SIMILARITY_THRESHOLD=0.98

# 画面内に複数表示される共有アイコンを重複検出しないための最小距離(px)
CONTROL_JANTAMA_ROW_MATCH_MIN_DISTANCE_PX=20
